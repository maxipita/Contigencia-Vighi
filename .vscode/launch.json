{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Contingencia — desarrollo (Cloudflare D1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "noDebug": true,
      "env": {
        "CONTINGENCIA_DESARROLLO": "1",
        "CONTINGENCIA_PUERTO": "8001"
      }
    },
    {
      "name": "Contingencia — con depurador (sin recarga)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "CONTINGENCIA_DESARROLLO": "1",
        "CONTINGENCIA_SIN_RECARGA": "1",
        "CONTINGENCIA_PUERTO": "8001"
      }
    }
  ]
}
